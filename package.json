{
	"name": "formatted-translator",
	"version": "0.1.0",
	"description": "Minimal translation web app for FormatJS/ICU JSON locale files with GitHub as the only store",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/LiteraryUniverse/gh-translate.git"
	},
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"postinstall": "WRANGLER_LOG=warn wrangler types > /dev/null 2>&1 || true"
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "^3.5.20",
		"@tanstack/solid-router": "^1.170.36",
		"@tanstack/solid-start": "^1.168.54",
		"intl-messageformat": "^12.1.2",
		"marked": "^18.0.13",
		"solid-js": "^1.9.15"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.57.0",
		"@types/node": "^22.20.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^5.0.1",
		"wrangler": "^4.136.0"
	}
}
